# --- Required ---
MONGODB_URI=mongodb+srv://user:pass@cluster/ReadmeDB
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=64-hex-chars-for-aes-256-gcm
APP_URL=http://localhost:3000

# --- Email (verification / password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM="Doodlebug <you@gmail.com>"

# --- Optional ---
# Server-wide fallback GitHub token used for public card fetching (raises rate limits a lot).
GITHUB_TOKEN=
# Only needed to (re)generate illustration assets via scripts/gen-assets.mjs
OPENAI_API_KEY=
