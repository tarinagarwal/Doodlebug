# --- Required ---
MONGODB_URI=mongodb+srv://user:pass@cluster/ReadmeDB
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=64-hex-chars-for-aes-256-gcm
APP_URL=http://localhost:3000

# --- Email (verification / password reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
MAIL_FROM="Doodlebug <you@gmail.com>"

# --- Optional ---
# Server-wide fallback GitHub token used for public card fetching (raises rate limits a lot).
GITHUB_TOKEN=
# Only needed to (re)generate illustration assets via scripts/gen-assets.mjs
OPENAI_API_KEY=

# --- Cache (optional but recommended) ---
# Upstash Redis for the GitHub data cache and rate-limit buckets. Without these the
# app falls back to MongoDB, which works but adds a round-trip to every card render.
# Create a REGIONAL database in the same region as your deployment, with eviction ON.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Search engines (optional) ---
# Token from Search Console "HTML tag" verification (the content="..." value only).
GOOGLE_SITE_VERIFICATION=
# Token from Bing Webmaster Tools, if not importing from Google.
BING_SITE_VERIFICATION=
